{
  "name": "nearena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:next\" \"npm run dev:server\"",
    "dev:next": "next dev -p 3000",
    "dev:server": "tsx src/server/gameServer.ts",
    "prebuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "build:web": "next build",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build",
    "start": "concurrently \"npm run start:next\" \"npm run start:server\"",
    "start:next": "node scripts/start-next.js",
    "start:server": "node dist/server/gameServer.js",
    "start:all": "npm run start",
    "lint": "next lint",
    "contract:build": "cd contracts-near && npm install && npm run build",
    "contract:deploy": "near contract deploy $NEXT_PUBLIC_NEAR_CONTRACT_NAME use-file contracts-near/build/btq_token.wasm with-init-call init json-args {} prepaid-gas '100 Tgas' attached-deposit '0 NEAR' network-config testnet sign-with-keychain send"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^8.10.1",
    "@near-wallet-selector/here-wallet": "^8.10.1",
    "@near-wallet-selector/meteor-wallet": "^8.10.1",
    "@near-wallet-selector/modal-ui": "^8.10.1",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.39",
    "@upstash/redis": "^1.37.0",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "near-api-js": "^4.0.4",
    "next": "16.2.2",
    "postcss": "^8.4.47",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.4.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tsx": "^4.21.0"
  }
}
